/target
**/*.rs.bk
**/*.rs.bak
**/*.rs.orig
Cargo.lock.bak
.DS_Store
*.swp
*.swo

# Local data dirs produced by examples / tests
*.tmp
/tmp-adnet-*

# Runtime data produced by `adnet-node` / `adnet-cli`
/.adnet-data/
/tmp-adnet/

# Proptest regression artifacts (only at the workspace root — keep them
# inside individual crates so test stability is preserved across clones)
/proptest-regressions/

# Editor / IDE
.idea/
.vscode/
*.iml

# Backup / unrelated directories
Exodus@src-backup/

# Local working artifacts (root-level only) — audit rounds, planning
# documents, status files, sqlite databases, and ad-hoc shell scripts
# that should not be published to the public mirror.
/AUDIT_*.md
/PLAN_*.md
/SAFETY_CASE.md
/CLI_FFI_IPC_ROSTER.md
/ADNET_VS_IPFS_GAP_ANALYSIS.md
/feature_status_matrix.md
/roster.sqlite
/test-mail.sh
/test-mail-full.sh
/.tmp_*.txt
