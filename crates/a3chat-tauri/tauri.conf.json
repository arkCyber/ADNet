{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "a3chat",
  "version": "0.1.0",
  "identifier": "network.a3net.a3chat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "login",
        "title": "a3chat — Login",
        "width": 360,
        "height": 540,
        "url": "login.html"
      },
      {
        "label": "chats",
        "title": "a3chat — Chats",
        "width": 960,
        "height": 640,
        "url": "chats.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
